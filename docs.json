{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kalixo Developers",
  "description": "Developer documentation for Kalixo: the Distribution API (catalog, ordering and wallet) and Kalixo Checkout (payments with Kalixo as merchant of record).",
  "colors": {
    "primary": "#a1c62e",
    "light": "#c9f73a",
    "dark": "#799423"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0a0c03"
    }
  },
  "logo": {
    "light": "/logo/kalixo-black.svg",
    "dark": "/logo/kalixo-white.svg",
    "href": "https://developer.kalixo.io"
  },
  "favicon": "/favicon.ico",
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:integrations@kalixo.io"
      },
      {
        "label": "Postman",
        "href": "/quickstart#postman-collection"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API keys",
      "href": "mailto:integrations@kalixo.io"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "Distribution API",
        "description": "Catalog, ordering and wallet",
        "icon": "gift",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get started",
                "pages": ["index", "quickstart", "authentication", "concepts/sandbox", "changelog"]
              },
              {
                "group": "Core concepts",
                "pages": [
                  "concepts/pagination",
                  "concepts/filtering",
                  "concepts/open-denomination",
                  "concepts/promotions",
                  "concepts/service-fee",
                  "concepts/order-lifecycle",
                  "concepts/order-cancellation",
                  "concepts/idempotency",
                  "concepts/rate-limits",
                  "concepts/errors",
                  "concepts/notifications",
                  "concepts/webhooks",
                  "examples/kalixo-node"
                ]
              },
              {
                "group": "Migrate",
                "pages": ["migrating-from-v1"]
              }
            ]
          },
          {
            "tab": "API reference",
            "groups": [
              {
                "group": "Overview",
                "pages": ["api-reference/introduction"]
              },
              {
                "group": "Endpoints",
                "openapi": "openapi.json"
              }
            ]
          }
        ]
      },
      {
        "product": "Checkout",
        "description": "Accept payments with Kalixo as merchant of record",
        "icon": "credit-card",
        "tabs": [
          {
            "tab": "Guides",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "checkout/index",
                  "checkout/quickstart",
                  "checkout/authentication",
                  "checkout/concepts/testing",
                  "checkout/changelog"
                ]
              },
              {
                "group": "Accept payments",
                "pages": [
                  "checkout/guides/kalixo-js",
                  "checkout/guides/hosted-checkout",
                  "checkout/guides/payment-links",
                  "checkout/guides/captures-and-refunds",
                  "checkout/guides/stored-payment-methods"
                ]
              },
              {
                "group": "After the payment",
                "pages": [
                  "checkout/concepts/webhooks",
                  "checkout/concepts/events",
                  "checkout/guides/disputes",
                  "checkout/guides/reports"
                ]
              },
              {
                "group": "Core concepts",
                "pages": [
                  "checkout/concepts/payment-lifecycle",
                  "checkout/concepts/amount-integrity",
                  "checkout/concepts/idempotency",
                  "checkout/concepts/errors",
                  "checkout/concepts/versioning"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "groups": [
              {
                "group": "Overview",
                "pages": ["checkout/api-reference/introduction"]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "checkout/openapi.yaml",
                  "directory": "checkout/api-reference"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["bash", "javascript", "python", "php"]
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "download-spec"]
  },
  "search": {
    "prompt": "Search the Kalixo developer docs"
  },
  "footer": {
    "socials": {
      "website": "https://kalixo.io",
      "linkedin": "https://www.linkedin.com/company/kalixo"
    }
  }
}
